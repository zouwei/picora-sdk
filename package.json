{
  "name": "@picora/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for Picora API (https://api.picora.me)",
  "license": "Apache-2.0",
  "homepage": "https://picora.me/developers",
  "repository": {
    "type": "git",
    "url": "https://github.com/picora/picora-service",
    "directory": "packages/sdk"
  },
  "keywords": ["picora", "api", "sdk", "typescript", "image-hosting", "media", "mcp"],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./errors": "./src/errors.ts",
    "./types": "./src/types.ts"
  },
  "files": ["dist", "src", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  }
}
