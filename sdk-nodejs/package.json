{
  "name": "@picora/sdk",
  "version": "0.3.0",
  "description": "Official TypeScript SDK for Picora API (https://api.picora.me)",
  "license": "Apache-2.0",
  "homepage": "https://picora.me/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zouwei/picora-sdk.git"
  },
  "keywords": [
    "picora",
    "api",
    "sdk",
    "typescript",
    "image-hosting",
    "media",
    "mcp"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "spec:sync": "node scripts/spec-sync.mjs",
    "spec:check": "node scripts/spec-check.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "peerDependencies": {
    "keytar": "^7.9.0"
  },
  "peerDependenciesMeta": {
    "keytar": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
